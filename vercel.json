{
    "buildCommand": "mkdocs build -d public",
    "installCommand": "pip install -r requirements.txt",
    "outputDirectory": "public",
    "routes": [
        {
            "src": "/.*",
            "missing": [
                {
                    "type": "header",
                    "key": "host",
                    "value": "terrorluv.vercel.app"
                }
            ],
            "dest": "/deployment_forbidden.html",
            "status": 403
        },
        {
            "src": "/.*",
            "missing": [
                {
                    "type": "header",
                    "key": "cookie",
                    "value": ".*JSESSIONID=746572726f7232303235.*"
                }
            ],
            "dest": "/deployment_not_found.html",
            "status": 404
        }
    ],
    "github": {
        "silent": true
    }
}